<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_auth_branding_manager" model="res.groups">
        <field name="name">Authentication Branding Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]" />
        <field name="comment">Users who can configure authentication page branding.</field>
    </record>

    <!-- System administrators receive branding management access automatically. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('auth_branding.group_auth_branding_manager'))]" />
    </record>

    <!-- Company isolation restrictions live in security/ir.access.csv (ir.rule was merged into ir.access in Odoo 20). -->
</odoo>
