<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="auth_branding.AccessibilityChecks" owl="1">
        <details class="ab-design-health mb-3" t-att-class="this.passedCount === this.checks.length ? 'is-passing' : 'has-warnings'">
            <summary class="d-flex align-items-center gap-2" aria-live="polite">
                <i class="oi" t-att-class="this.passedCount === this.checks.length ? 'text-success' : 'text-warning'" t-att-data-icon="this.passedCount === this.checks.length ? 'check_circle' : 'warning'" />
                <strong>Design health</strong>
                <span class="small text-muted"><t t-out="this.passedCount"/>/<t t-out="this.checks.length"/> contrast checks passed</span>
                <span class="ms-auto small text-muted">Show details</span>
            </summary>
            <div class="ab-design-health-list mt-2">
                <div class="d-flex align-items-start gap-2 py-2" t-foreach="this.checks" t-as="check" t-key="check.key">
                    <i class="oi mt-1" t-att-class="check.pass ? 'text-success' : 'text-danger'" t-att-data-icon="check.pass ? 'check_circle' : 'error'" />
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2">
                            <span><t t-out="check.label"/></span>
                            <span class="badge" t-att-class="check.pass ? 'text-bg-success' : 'text-bg-danger'"><t t-out="this.formatRatio(check.ratio)"/></span>
                            <button
                                t-if="!check.pass"
                                type="button"
                                class="btn btn-sm btn-outline-primary ms-auto ab-contrast-fix"
                                t-on-click="() => this.fixCheck(check)"
                            >Fix contrast</button>
                        </div>
                        <div class="small text-muted"><t t-out="check.hint"/></div>
                    </div>
                </div>
            </div>
        </details>
    </t>
</templates>
