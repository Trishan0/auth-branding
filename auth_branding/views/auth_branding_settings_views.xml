<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auth_branding_config_view_form" model="ir.ui.view">
        <field name="name">auth.branding.config.view.form</field>
        <field name="model">auth.branding.config</field>
        <field name="arch" type="xml">
            <form string="Authentication Branding" class="o_auth_branding_form">
                <header>
                    <button name="action_save" string="Save" type="object" class="oe_highlight" />
                    <field name="company_id" invisible="1" />
                </header>
                <sheet>
                    <div class="o_auth_branding_header d-flex align-items-center mb-4">
                        <div class="flex-grow-1">
                            <h3>Branding for <field name="company_id" readonly="1" options="{'no_open': True}" /></h3>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-5">
                            <group string="Layout &amp; Structure">
                                <field name="template" widget="auth_branding_template_picker" />
                                <field name="split_alignment" invisible="template != 'split'" />
                            </group>
                            <group string="Card &amp; Effects">
                                <field name="card_background_color" widget="auth_branding_color" />
                                <field name="glassmorphism" widget="boolean_toggle" />
                                <field name="glassmorphism_blur" invisible="glassmorphism == False" />
                                <field name="glassmorphism_opacity" invisible="glassmorphism == False" />
                            </group>
                            <group string="Branding">
                                <field name="company_logo" widget="image" options="{'size': [0, 90]}" />
                                <field name="favicon" widget="image" options="{'size': [0, 90]}" />
                                <field name="tagline" />
                            </group>
                            <group string="Colors">
                                <field name="primary_color" widget="auth_branding_color" />
                                <field name="secondary_color" widget="auth_branding_color" />
                                <field name="background_type" />
                                <field
                                    name="background_color"
                                    widget="auth_branding_color"
                                    invisible="background_type != 'solid'"
                                />
                                <field
                                    name="gradient_start"
                                    widget="auth_branding_color"
                                    invisible="background_type != 'gradient'"
                                />
                                <field
                                    name="gradient_end"
                                    widget="auth_branding_color"
                                    invisible="background_type != 'gradient'"
                                />
                                <field
                                    name="gradient_direction"
                                    invisible="background_type != 'gradient'"
                                />
                                <field
                                    name="background_image"
                                    widget="image"
                                    invisible="background_type != 'image'"
                                />
                                <field name="background_overlay_opacity"
                                    invisible="background_type != 'image'"
                                />
                            </group>
                            <group string="Typography &amp; Elements">
                                <field name="font_family" />
                                <field name="text_color" widget="auth_branding_color" />
                                <field name="input_border_radius" />
                                <field name="button_border_radius" />
                                <field name="button_color" widget="auth_branding_color" />
                                <field name="button_text_color" widget="auth_branding_color" />
                            </group>
                            <group string="Footer Elements">
                                <field name="show_manage_databases" widget="boolean_toggle" />
                                <field name="show_powered_by_odoo" widget="boolean_toggle" />
                                <field name="custom_footer_text" placeholder="e.g. Support: +1 800 000 0000" />
                            </group>
                            <group string="Custom Content">
                                <field name="login_welcome_title" placeholder="e.g. Welcome back!" />
                                <field name="login_welcome_subtitle" placeholder="e.g. Sign in to continue." />
                            </group>
                            <group string="Terms &amp; Privacy Links">
                                <field name="terms_url" placeholder="https://yoursite.com/terms" />
                                <field name="terms_label" />
                                <field name="privacy_url" placeholder="https://yoursite.com/privacy" />
                                <field name="privacy_label" />
                            </group>
                            <group string="Security &amp; Auth">
                                <field name="auth_signup_uninvited" widget="radio" options="{'horizontal': true}" />
                                <field name="auth_signup_reset_password" widget="boolean_toggle" />
                            </group>
                        </div>
                        <div class="col-md-7">
                            <widget name="auth_branding_preview" />
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Server action to open the single configuration record -->
    <record id="action_auth_branding_config_server" model="ir.actions.server">
        <field name="name">Authentication Branding</field>
        <field name="model_id" ref="model_auth_branding_config" />
        <field name="state">code</field>
        <field name="code">
config = env['auth.branding.config'].get_or_create()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Authentication Branding',
    'res_model': 'auth.branding.config',
    'res_id': config.id,
    'view_mode': 'form',
    'target': 'current',
}
        </field>
    </record>
</odoo>
