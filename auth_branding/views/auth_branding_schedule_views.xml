<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auth_branding_schedule_view_list" model="ir.ui.view">
        <field name="name">auth.branding.schedule.view.list</field>
        <field name="model">auth.branding.schedule</field>
        <field name="arch" type="xml">
            <list string="Scheduled Branding Publishes" create="0" edit="0" delete="0" decoration-info="state == 'pending'" decoration-success="state == 'published'" decoration-muted="state == 'cancelled'" decoration-danger="state == 'failed'">
                <field name="name" />
                <field name="scheduled_at" />
                <field name="created_by" />
                <field name="note" optional="show" />
                <field name="state" widget="badge" />
                <field name="executed_at" optional="hide" />
                <button name="action_cancel" string="Cancel" type="object" icon="fa-ban" invisible="state != 'pending'" confirm="Cancel this scheduled publish?" />
            </list>
        </field>
    </record>

    <record id="auth_branding_schedule_view_form" model="ir.ui.view">
        <field name="name">auth.branding.schedule.view.form</field>
        <field name="model">auth.branding.schedule</field>
        <field name="arch" type="xml">
            <form string="Scheduled Branding Publish" create="0" edit="0" delete="0">
                <header>
                    <button name="action_cancel" string="Cancel Schedule" type="object" class="btn-secondary" invisible="state != 'pending'" confirm="Cancel this scheduled publish?" />
                    <field name="state" widget="statusbar" statusbar_visible="pending,published,cancelled,failed" />
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" /></h1></div>
                    <group>
                        <group>
                            <field name="config_id" />
                            <field name="company_id" />
                            <field name="scheduled_at" />
                            <field name="note" />
                        </group>
                        <group>
                            <field name="created_by" />
                            <field name="executed_at" invisible="not executed_at" />
                            <field name="version_id" invisible="not version_id" />
                        </group>
                    </group>
                    <div class="alert alert-danger" invisible="state != 'failed'">
                        <strong>Publishing failed.</strong>
                        <field name="error_message" nolabel="1" readonly="1" />
                    </div>
                    <group string="Captured Assets">
                        <field name="company_logo" widget="image" />
                        <field name="favicon" widget="image" />
                        <field name="background_image" widget="image" />
                    </group>
                    <group string="Technical Snapshot" groups="base.group_no_one">
                        <field name="settings_snapshot" widget="json" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_auth_branding_schedule" model="ir.actions.act_window">
        <field name="name">Scheduled Branding Publishes</field>
        <field name="res_model">auth.branding.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="target">current</field>
    </record>
</odoo>
