<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="auth_branding_wizard_view_form" model="ir.ui.view">
        <field name="name">auth.branding.wizard.view.form</field>
        <field name="model">auth.branding.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Branding Setup" class="o_auth_branding_wizard">
                <field name="config_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <div class="ab-wizard-progress mb-4">
                    <field name="state" widget="statusbar" options="{'clickable': false}" statusbar_visible="identity,style,review" />
                </div>

                <sheet>
                    <div invisible="state != 'identity'">
                        <h3>Bring in your brand</h3>
                        <p class="text-muted">Upload a logo and choose a starting theme. We will suggest colors automatically.</p>
                        <group>
                            <group string="Brand Identity">
                                <field name="company_logo" widget="image" options="{'size': [0, 140]}" />
                                <field name="tagline" placeholder="e.g. Welcome back" />
                            </group>
                            <group string="Starting Point">
                                <field name="preset_id" options="{'no_create': True, 'no_open': True}" />
                                <field name="suggested_primary_color" widget="auth_branding_color" readonly="1" invisible="not suggested_primary_color" />
                                <field name="suggested_secondary_color" widget="auth_branding_color" readonly="1" invisible="not suggested_secondary_color" />
                            </group>
                        </group>
                    </div>

                    <div invisible="state != 'style'">
                        <div class="row g-4">
                            <div class="col-lg-5">
                                <group string="Layout &amp; Colors">
                                    <field name="template" />
                                    <field name="split_alignment" invisible="template not in ('split', 'sidebar')" />
                                    <field name="primary_color" widget="auth_branding_color" />
                                    <field name="secondary_color" widget="auth_branding_color" />
                                    <field name="background_type" />
                                    <field name="background_color" widget="auth_branding_color" invisible="background_type != 'solid'" />
                                    <field name="gradient_start" widget="auth_branding_color" invisible="background_type not in ('gradient', 'animated_gradient')" />
                                    <field name="gradient_end" widget="auth_branding_color" invisible="background_type not in ('gradient', 'animated_gradient')" />
                                    <field name="gradient_direction" invisible="background_type != 'gradient'" />
                                    <field name="font_family" />
                                    <field name="text_color" widget="auth_branding_color" />
                                    <field name="card_background_color" widget="auth_branding_color" />
                                    <field name="glassmorphism" widget="boolean_toggle" />
                                    <field name="glassmorphism_blur" invisible="not glassmorphism" />
                                    <field name="glassmorphism_opacity" invisible="not glassmorphism" />
                                    <field name="input_border_radius" />
                                    <field name="button_border_radius" />
                                    <field name="button_color" widget="auth_branding_color" />
                                    <field name="button_text_color" widget="auth_branding_color" />
                                </group>
                            </div>
                            <div class="col-lg-7">
                                <widget name="auth_branding_preview" />
                            </div>
                        </div>
                    </div>

                    <div invisible="state != 'review'">
                        <div class="text-center mb-4">
                            <i class="fa fa-check-circle text-success fa-3x mb-2" />
                            <h3>Ready to apply</h3>
                            <p class="text-muted">Review the main choices below. You can continue editing them later in Brand Studio.</p>
                        </div>
                        <group>
                            <group string="Brand">
                                <field name="company_logo" widget="image" readonly="1" />
                                <field name="tagline" readonly="1" />
                                <field name="preset_id" readonly="1" />
                            </group>
                            <group string="Style">
                                <field name="template" readonly="1" />
                                <field name="primary_color" widget="auth_branding_color" readonly="1" />
                                <field name="secondary_color" widget="auth_branding_color" readonly="1" />
                                <field name="background_type" readonly="1" />
                                <field name="font_family" readonly="1" />
                            </group>
                        </group>
                    </div>
                </sheet>

                <footer>
                    <button name="action_previous" string="Back" type="object" class="btn-secondary" invisible="state == 'identity'" />
                    <button name="action_next" string="Continue" type="object" class="btn-primary" invisible="state == 'review'" />
                    <button name="action_apply" string="Apply Branding" type="object" class="btn-primary" invisible="state != 'review'" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_auth_branding_wizard" model="ir.actions.act_window">
        <field name="name">Quick Branding Setup</field>
        <field name="res_model">auth.branding.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="auth_branding_wizard_view_form" />
        <field name="target">new</field>
    </record>

    <record id="action_auth_branding_wizard_server" model="ir.actions.server">
        <field name="name">Quick Branding Setup</field>
        <field name="model_id" ref="model_auth_branding_config" />
        <field name="state">code</field>
        <field name="code">
config = env['auth.branding.config']._get_or_create_config()
action = config.action_open_setup_wizard()
        </field>
    </record>

    <record id="auth_branding_import_wizard_view_form" model="ir.ui.view">
        <field name="name">auth.branding.import.wizard.view.form</field>
        <field name="model">auth.branding.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Authentication Branding">
                <field name="config_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <field name="state" invisible="1" />
                <field name="normalized_payload" invisible="1" />
                <sheet>
                    <div invisible="state != 'upload'">
                        <h3>Import a branding package</h3>
                        <p class="text-muted">
                            Choose a JSON file exported by Auth Branding. The import becomes a draft, so your live login page stays unchanged until you publish.
                        </p>
                        <group>
                            <field name="import_file" filename="import_filename" />
                            <field name="import_filename" invisible="1" />
                        </group>
                    </div>
                    <div invisible="state != 'review'">
                        <div class="alert alert-warning" role="alert">
                            Applying this package replaces matching draft settings and assets. It does not publish them.
                        </div>
                        <group string="Import Summary">
                            <field name="import_summary" nolabel="1" readonly="1" />
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_review" string="Review Import" type="object" class="btn-primary" invisible="state != 'upload'" />
                    <button name="action_back" string="Back" type="object" class="btn-secondary" invisible="state != 'review'" />
                    <button name="action_apply" string="Apply as Draft" type="object" class="btn-primary" invisible="state != 'review'" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_auth_branding_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Authentication Branding</field>
        <field name="res_model">auth.branding.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="auth_branding_import_wizard_view_form" />
        <field name="target">new</field>
    </record>

    <record id="auth_branding_preset_wizard_view_form" model="ir.ui.view">
        <field name="name">auth.branding.preset.wizard.view.form</field>
        <field name="model">auth.branding.preset.wizard</field>
        <field name="arch" type="xml">
            <form string="Save Current Theme">
                <field name="config_id" invisible="1" />
                <field name="company_id" invisible="1" />
                <sheet>
                    <h3>Turn these visual settings into a reusable theme</h3>
                    <p class="text-muted">The custom theme is available only to this company and can be deleted later.</p>
                    <group>
                        <field name="name" placeholder="e.g. Spring Campaign" />
                        <field name="description" placeholder="A short note to help teammates choose it" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_save" string="Save Theme" type="object" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_auth_branding_preset_wizard" model="ir.actions.act_window">
        <field name="name">Save Current Theme</field>
        <field name="res_model">auth.branding.preset.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="auth_branding_preset_wizard_view_form" />
        <field name="target">new</field>
    </record>
</odoo>
